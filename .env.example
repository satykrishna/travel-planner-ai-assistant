# Copy to .env and fill in your own keys. Never commit .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Private password for this app. Generate with: openssl rand -hex 32
# Required on Vercel; enter this value in the web app's access-key field.
APP_ACCESS_TOKEN=
# Emergency spending kill switch: set false and redeploy to pause live planning.
PLANNING_ENABLED=true
# Optional server-side observability. Add the key here locally and in Vercel.
# Prompt/response content is always hidden by the application's trace client.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=travel-planner
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only required for keys associated with multiple workspaces.
LANGSMITH_WORKSPACE_ID=
